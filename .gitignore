# ==============================================================================
# FormatNook - Git Ignore Configuration
# Ensures only essential source files are tracked in version control
# ==============================================================================

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
package-lock.json.backup

# Next.js Build Outputs & Caches
.next/
out/
build/
dist/
.swc/

# TypeScript Build Info
*.tsbuildinfo
next-env.d.ts.bak

# Playwright & Testing Artifacts
test-results/
playwright-report/
blob-report/
playwright/.cache/
coverage/
.nyc_output/

# Environment Variables & Secrets (Keep .env.example)
.env*.local
.env
.env.production
.env.development
.env.test
!.env.example

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor Configurations
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Logs & Temporary Files
*.log
logs/
tmp/
temp/
